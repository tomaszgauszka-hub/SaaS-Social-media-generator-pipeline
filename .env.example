# ============================================================================
# Content Revenue Engine — environment configuration
# Copy to .env (repo root) and adjust. Never commit real secrets.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# Public base URL of the web app. Used to build tracking links (/go/:code), bio pages and OAuth redirects.
APP_URL=http://localhost:3000

# --- Infrastructure ----------------------------------------------------------
DATABASE_URL=postgresql://cre:cre@localhost:5432/cre
# Optional: separate database for integration tests (defaults to <DATABASE_URL db>_test)
# DATABASE_URL_TEST=postgresql://cre:cre@localhost:5432/cre_test
REDIS_URL=redis://localhost:6379

# --- Safety switches (defaults are SAFE: nothing is paid, nothing is published) ---
# Mock providers: no external API calls, no spend. Mock mode still renders real videos locally.
MOCK_AI=true
MOCK_MEDIA=true
MOCK_SOCIAL=true
# simulate = mock operations record the cost the real provider WOULD have charged (flagged isMock)
# zero     = mock operations record $0
MOCK_COST_MODE=simulate
# Hard kill-switch for real publishing. Even with real credentials nothing is posted unless true.
PUBLISHING_ENABLED=false
# System-wide ceiling on paid API spend per UTC day across all workspaces (fail-safe on top of DB budgets).
HARD_DAILY_BUDGET_USD=5

# --- Security -----------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Secret used to derive the daily-rotating salt for anonymous visitor hashes in click tracking.
TRACKING_HASH_SECRET=
# FX rates to USD for conversion postbacks in other currencies, e.g. EUR=1.08,GBP=1.27 (keep them current;
# CSV imports take rates per import). Postbacks in a currency without a rate are rejected, never guessed.
FX_RATES_USD=
# Initial owner account created by `pnpm db:seed`
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now

# --- LLM (text / reasoning) ----------------------------------------------------
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional OpenAI-compatible endpoint (OpenAI, local vLLM/Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Media providers -----------------------------------------------------------
IMAGE_PROVIDER=fal
VIDEO_PROVIDER=fal
BG_REMOVAL_PROVIDER=fal
# tts: mock | flite (free, local, robotic) | openai | elevenlabs
TTS_PROVIDER=openai
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Storage -------------------------------------------------------------------
# local | s3 (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Social platforms ------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# SELF_ONLY (private, default) | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE
# Unaudited TikTok apps can only post SELF_ONLY. Public posting requires TikTok's app audit.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Worker / rendering ------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# x264 preset for final renders (ultrafast … veryslow). veryfast is a good small-VPS default.
RENDER_PRESET=veryfast
RENDER_CONCURRENCY=1
WORKER_CONCURRENCY=4
# How often the dispatcher polls for due job rows (ms)
DISPATCHER_POLL_MS=1000
# Scratch directory for intermediate render files
WORK_DIR=.data/work

# --- Google AI (reel factory) ----------------------------------------------------
# Without any Google credential every Google capability falls back to its local provider (template director,
# local music, Piper TTS, local alignment, lexical retrieval …); nothing breaks and nothing is paid.
# Gemini API key (Google AI Studio): director, product analysis, transcreation, visual QA, Gemini image,
# Lyria music, Gemini TTS, Gemini transcription, embeddings, Veo *-preview ids.
GOOGLE_API_KEY=
GOOGLE_GENAI_BASE_URL=https://generativelanguage.googleapis.com
# OAuth access token for Cloud Text-to-Speech (exact word timings via SSML marks), Speech-to-Text v2 (chirp_*)
# and Agent Platform (Veo *-001 ids), e.g. `gcloud auth print-access-token` (expires after ~1 h; refresh it).
GOOGLE_CLOUD_ACCESS_TOKEN=
# Quota / billing project (x-goog-user-project); required for Speech-to-Text v2 and Agent Platform Veo
GOOGLE_CLOUD_PROJECT=
# global | us | eu | a region. "global" → Speech-to-Text in the `us` multi-region, Veo in us-central1.
GOOGLE_CLOUD_LOCATION=global
# Model ids live here only (checked 2026-10-08, see docs/GOOGLE_AI.md); business logic never names a model.
GOOGLE_DIRECTOR_MODEL=gemini-3.5-flash-lite
GOOGLE_DIRECTOR_FALLBACK_MODEL=gemini-3.8-flash
# background plates / storyboards / stylised elements only — never the product itself
GOOGLE_IMAGE_MODEL=gemini-nano-banana-2.1
GOOGLE_MUSIC_MODEL=lyria-3.5
# No Lyria-specific commercial licence was found on Google's pages: Lyria runs for commercial reels only after
# you checked the terms of your account / contract and set this to true.
GOOGLE_MUSIC_COMMERCIAL_USE=false
GOOGLE_TTS_MODEL=gemini-3.8-flash-tts
# default Gemini TTS voice (prebuilt: Kore, Puck, Charon, Aoede, …); brands override it per locale
GOOGLE_TTS_VOICE=Kore
# gemini-3.5-transcribe (API key) | chirp_3 (Speech-to-Text v2: access token + project, ≤ 60 s per clip)
GOOGLE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
# 128–3072 (768 / 1536 / 3072 recommended). Changing model or size requires re-embedding the asset index.
GOOGLE_EMBEDDING_DIMENSIONS=768
# veo-3.1-*-generate-001 → Agent Platform (token + project) · veo-3.1-*-preview → Gemini API key (shutdown 2026-10-22)
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-001
# client-side cap on Google requests per minute, shared by every call of the process
GOOGLE_MAX_RPM=60

# --- Generative video (last resort) ------------------------------------------------
# Off by default. Even when enabled, the quality tier and the job budget must allow it.
GENERATIVE_VIDEO_ENABLED=false
# hard cap of generated seconds per reel (0–10). Veo bills at least 4 s per clip (shorter shots are trimmed).
REEL_MAX_GENERATIVE_VIDEO_SECONDS=0

# --- Blender product studio --------------------------------------------------------
# Python interpreter with the `bpy` module (Blender as a Python module) …
BLENDER_PYTHON=.tools/blender-venv/bin/python
# … or a Blender executable instead (blender -b -P script.py)
BLENDER_BIN=
# render threads (0 = all cores)
BLENDER_THREADS=0
# Blender renders running at once on this host (host-wide CPU/GPU lock)
BLENDER_MAX_CONCURRENT=1

# --- Local TTS (Piper) -------------------------------------------------------------
PIPER_BIN=.tools/piper/piper/piper
# directory with <voice>.onnx + <voice>.onnx.json files (e.g. pl-mls_6892-low, en-us-lessac-medium)
PIPER_VOICES_DIR=.tools/piper/voices

# --- Reel factory -------------------------------------------------------------------
# content-addressed cache: renders, music, voice, transcripts, embeddings, director results (safe to delete)
REEL_CACHE_DIR=.data/reel-cache
# finished reels, posters, plans and manifests
REEL_OUTPUT_DIR=.data/reels
