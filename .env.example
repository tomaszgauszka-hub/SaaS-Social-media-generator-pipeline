# ============================================================================
# Content Revenue Engine — environment configuration
# Copy to .env (repo root) and adjust. Never commit real secrets.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# Public base URL of the web app. Used to build tracking links (/go/:code), bio pages and OAuth redirects.
APP_URL=http://localhost:3000

# --- Infrastructure ----------------------------------------------------------
DATABASE_URL=postgresql://cre:cre@localhost:5432/cre
# Optional: separate database for integration tests (defaults to <DATABASE_URL db>_test)
# DATABASE_URL_TEST=postgresql://cre:cre@localhost:5432/cre_test
REDIS_URL=redis://localhost:6379

# --- Safety switches (defaults are SAFE: nothing is paid, nothing is published) ---
# Mock providers: no external API calls, no spend. Mock mode still renders real videos locally.
MOCK_AI=true
MOCK_MEDIA=true
MOCK_SOCIAL=true
# simulate = mock operations record the cost the real provider WOULD have charged (flagged isMock)
# zero     = mock operations record $0
MOCK_COST_MODE=simulate
# Hard kill-switch for real publishing. Even with real credentials nothing is posted unless true.
PUBLISHING_ENABLED=false
# System-wide ceiling on paid API spend per UTC day across all workspaces (fail-safe on top of DB budgets).
HARD_DAILY_BUDGET_USD=5

# --- Security -----------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Secret used to derive the daily-rotating salt for anonymous visitor hashes in click tracking.
TRACKING_HASH_SECRET=
# FX rates to USD for conversion postbacks in other currencies, e.g. EUR=1.08,GBP=1.27 (keep them current;
# CSV imports take rates per import). Postbacks in a currency without a rate are rejected, never guessed.
FX_RATES_USD=
# Initial owner account created by `pnpm db:seed`
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now

# --- LLM (text / reasoning) ----------------------------------------------------
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional OpenAI-compatible endpoint (OpenAI, local vLLM/Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Media providers -----------------------------------------------------------
IMAGE_PROVIDER=fal
VIDEO_PROVIDER=fal
BG_REMOVAL_PROVIDER=fal
# tts: mock | flite (free, local, robotic) | openai | elevenlabs
TTS_PROVIDER=openai
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Storage -------------------------------------------------------------------
# local | s3 (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Social platforms ------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Worker / rendering ------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# x264 preset for final renders (ultrafast … veryslow). veryfast is a good small-VPS default.
RENDER_PRESET=veryfast
RENDER_CONCURRENCY=1
WORKER_CONCURRENCY=4
# How often the dispatcher polls for due job rows (ms)
DISPATCHER_POLL_MS=1000
