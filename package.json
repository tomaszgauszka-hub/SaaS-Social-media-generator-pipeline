{
  "name": "content-revenue-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Automated multi-brand content → distribution → analytics → revenue optimization engine",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @cre/db generate",
    "dev": "pnpm --filter @cre/web dev",
    "build": "pnpm --filter @cre/web build",
    "start": "pnpm --filter @cre/web start",
    "worker": "pnpm --filter @cre/worker start",
    "worker:dev": "pnpm --filter @cre/worker dev",
    "demo": "pnpm --filter @cre/worker demo",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "db:generate": "pnpm --filter @cre/db generate",
    "db:migrate": "pnpm --filter @cre/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @cre/db migrate:dev",
    "db:seed": "pnpm --filter @cre/db seed",
    "db:reset": "pnpm --filter @cre/db reset",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@cre/config": "workspace:*",
    "@cre/db": "workspace:*",
    "@cre/media": "workspace:*",
    "@cre/shared": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
