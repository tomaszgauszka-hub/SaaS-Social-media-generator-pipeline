// Content Revenue Engine — PostgreSQL schema (Prisma 7)
//
// Conventions
//  * money: Decimal(18,6) USD. Revenue keeps original currency + fx rate + USD amount.
//  * estimates (OpportunityScore, estimatedCostUsd) are stored separately from actuals
//    (AnalyticsSnapshot, RevenueEntry, actualCostUsd).
//  * workflow state is an explicit enum per entity — never boolean flags.
//  * media files live in object storage; rows store keys + provenance only.
//  * isMock / isSimulated mark data produced by mock providers so it is never mistaken for real money.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

